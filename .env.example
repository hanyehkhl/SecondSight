# Copy to .env and adjust. Every setting in app/core/config.py can be set here (case-insensitive).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=insecure-development-secret-change-me-in-production
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORAGE_ENCRYPTION_KEY=

DATABASE_URL=sqlite+aiosqlite:///./data/secondsight.db
# DATABASE_URL=postgresql+asyncpg://secondsight:secondsight@localhost:5432/secondsight

STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=secondsight
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# mock | medasr_local | medasr_http
SPEECH_BACKEND=mock
# MEDASR_ENDPOINT_URL=http://localhost:9001/transcribe

# mock | medgemma_local | medgemma_openai
VISION_BACKEND=mock
MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it
# MEDGEMMA_ENDPOINT_URL=http://localhost:8001/v1

# Results below this overall confidence are flagged "needs human review"
MIN_CONFIDENCE_THRESHOLD=0.6
DEFAULT_REPORT_LANGUAGE=en
REPORT_LLM_ENABLED=false

# inline (in the API process) | celery (separate worker, needs Redis)
TASK_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# NOTIFICATION_WEBHOOK_URL=
# CORS_ORIGINS=["http://localhost:3000"]
